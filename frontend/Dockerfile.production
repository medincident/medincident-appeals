# --- Stage 1: Install all deps (для билда нужны и dev) ---
FROM oven/bun:1-alpine AS deps
WORKDIR /app
RUN apk add --no-cache libc6-compat
COPY package.json bun.lock* ./
RUN --mount=type=cache,target=/root/.bun/install/cache \
    bun install --frozen-lockfile

# --- Stage 2: Build (next build с output: "standalone") ---
FROM oven/bun:1-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

ARG AUTH_APP_URL
ARG AUTH_ORG_ID
ARG APP_URL
ARG AUTH_CLIENT_ID
ARG AUTH_SECRET
ARG NEXT_PUBLIC_AUTH_APP_URL

ENV AUTH_APP_URL=${AUTH_APP_URL} \
    AUTH_ORG_ID=${AUTH_ORG_ID} \
    APP_URL=${APP_URL} \
    AUTH_CLIENT_ID=${AUTH_CLIENT_ID} \
    AUTH_SECRET=${AUTH_SECRET} \
    NEXT_PUBLIC_AUTH_APP_URL=${NEXT_PUBLIC_AUTH_APP_URL} \
    NEXT_TELEMETRY_DISABLED=1

RUN bun --bun run next build

# --- Stage 3: Minimal runner (только standalone + static + public) ---
FROM oven/bun:1-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# standalone уже содержит server.js + нужные node_modules + next.config.
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

USER nextjs
EXPOSE 3000

CMD ["bun", "--bun", "--smol", "server.js"]
