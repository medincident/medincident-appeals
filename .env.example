# Скопируй в .env и заполни секретами:
#   cp .env.example .env

# ── Auth (Zitadel) ──────────────────────────────────────────────────────────
# URL экземпляра Zitadel (issuer для OIDC).
AUTH_APP_URL=https://zitadel.example.com
# ID организации в Zitadel.
AUTH_ORG_ID=
# OAuth client_id фронтенда.
AUTH_CLIENT_ID=
# Секрет для шифрования JWT/cookies (32 байта base64). Сгенерировать: `openssl rand -base64 32`.
AUTH_SECRET=
# Внешний URL приложения (где живёт фронтенд).
APP_URL=https://app.example.com
# Куда возвращается NextAuth callback. Обычно совпадает с APP_URL.
AUTH_URL=https://app.example.com
# То же что AUTH_APP_URL, но инлайнится в JS-бандл (NEXT_PUBLIC_*) — нужен для client-side OIDC.
NEXT_PUBLIC_AUTH_APP_URL=https://app.example.com

# ── Внутренние сервисы (Docker network) ─────────────────────────────────────
NATS_URL=nats://nats:4222
BACKEND_URL=http://backend:8080

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=medincident
POSTGRES_PASSWORD=medincident
POSTGRES_DB=medincident

# ── Backend (.NET) ──────────────────────────────────────────────────────────
APP_HTTP_ADDR=:8080
ZITADEL_ISSUER=https://zitadel.example.com
APPDB_CONNECTION_STRING=Host=postgres;Port=5432;Username=medincident;Password=medincident;Database=medincident;SslMode=Disable;Maximum Pool Size=10;Include Error Detail=true

# ── Categories ──────────────────────────────────────────────────────────────
# true → встроенные моки; false → реальные категории из medincident-backend.
CATEGORIES_USE_STUB=false
MEDINCIDENT_SERVER_URL=http://gateway-server:8080
CATEGORIES_ORG_ID=
CATEGORIES_POLL_SECONDS=300
# Zitadel machine key (JWT-Bearer) для service-токена; нужен при CATEGORIES_USE_STUB=false.
CATEGORIES_MACHINE_KEY_HOST_PATH=./secrets/key.json
CATEGORIES_MACHINE_KEY_PATH=/app/secrets/key.json
CATEGORIES_PROJECT_ID=

# ── Medincident submission ──────────────────────────────────────────────────
# Включает отправку обращений в medincident-backend и подписку на его статус-события.
MEDINCIDENT_ENABLED=false
MEDINCIDENT_ORG_ID=
MEDINCIDENT_NATS_URL=nats://backend_nats:4222
MEDINCIDENT_BUS_NETWORK=prod_default

# ── LLM ─────────────────────────────────────────────────────────────────────
# Какой GGUF берёт llm-service из models_cache/gguf/.
# Имя файла: <repo-без-суффикса-GGUF>-<quant>.gguf
#   unsloth/Qwen3-4B-GGUF + Q4_K_M → models_cache/gguf/Qwen3-4B-Q4_K_M.gguf
LLM_REPO=unsloth/Qwen3-4B-GGUF
LLM_QUANT=Q4_K_M

# ── Watchtower + GHCR ───────────────────────────────────────────────────────
# Watchtower следит за контейнерами с метками
#   com.centurylinklabs.watchtower.enable=true
#   com.centurylinklabs.watchtower.scope=medincident-appeals
# и подтягивает свежие образы из GHCR с тегом :latest.
#
# GitHub username или организация, которая владеет пакетом
GHCR_USERNAME=your-github-username
# GitHub Personal Access Token с правом read:packages
GHCR_TOKEN=ghp_xxxxxxxxxxxxxxxx
# Интервал проверки обновлений (секунды). 3600 = 1 час
WATCHTOWER_POLL_INTERVAL=3600
# Опционально: Shoutrrr URL для уведомлений (Slack, Telegram и т.д.)
# https://containrrr.dev/shoutrrr/services/overview/
WATCHTOWER_NOTIFICATIONS=
WATCHTOWER_NOTIFICATION_URL=
# Timezone для логов watchtower
TZ=Europe/Moscow
